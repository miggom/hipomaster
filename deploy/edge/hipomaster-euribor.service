# edge-04. Euríbor y tipos BdE diarios.
[Unit]
Description=HipoMaster Euríbor y tipos BdE
After=docker.service tailscaled.service ollama.service
Requires=docker.service

[Service]
Type=oneshot
TimeoutStartSec=15m
EnvironmentFile=/etc/hipomaster/scraper.env
ExecStartPre=-/usr/bin/curl -fsS -m 10 ${HC_URL}/start
ExecStart=/usr/bin/docker run --rm --name hipo-euribor --network host \
  --memory 512m --env-file /etc/hipomaster/scraper.env \
  ${SCRAPER_IMAGE}:${SCRAPER_TAG} euribor
ExecStartPost=/usr/bin/curl -fsS -m 10 ${HC_URL}
ExecStopPost=/bin/sh -c '[ "$SERVICE_RESULT" = success ] || /usr/bin/curl -fsS -m 10 ${HC_URL}/fail'
